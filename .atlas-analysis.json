  "keyFeatures": [
    "Two ergonomic APIs: derive macros (#[derive(Parser)]) and a builder pattern",
    "Auto-generated help and version output with shell-aware color",
    "Shell completion generation for bash, zsh, fish, elvish, and PowerShell via clap_complete",
    "Man page generation via clap_mangen",
    "Rich argument types: positional, options, flags, subcommands, and value enums",
    "Custom value parsers and validators with strong type inference",
    "Argument groups, conflicts, requirements, and dependency relations",
    "Environment variable fallback for argument values",
    "Multicall binary support (e.g., busybox-style binaries)",
    "Typo suggestion ('Did you mean?') for user errors",
    "Unicode, terminal-width help wrapping, and styled output"
  ],
  "publicApiSurface": [
